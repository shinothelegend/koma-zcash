{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {"api/proxy.mjs": {"maxDuration": 120}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/proxy?upstream=/api/:path*"},
    {"source": "/art/:path*", "destination": "/api/proxy?upstream=/art/:path*"}
  ],
  "headers": [{
    "source": "/:path*",
    "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Frame-Options", "value": "DENY"}
    ]
  }]
}
